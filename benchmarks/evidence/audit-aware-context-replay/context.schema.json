{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "inspirations"
  ],
  "properties": {
    "inspirations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "hypothesis",
          "instructions",
          "risk",
          "parent_attempt_id",
          "reference_attempt_ids"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "hypothesis": {
            "type": "string"
          },
          "instructions": {
            "type": "string"
          },
          "risk": {
            "type": "string"
          },
          "parent_attempt_id": {
            "type": "string"
          },
          "reference_attempt_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}